# Variant of .dockerignore for Dockerfile.prebuilt.
# Allows `out/web/` through (the prebuilt web bundle) while still
# excluding everything else that bloats the build context.

# Build artifacts — keep out/web (prebuilt), drop the rest
dist
out/main
out/preload
out/remote
out/renderer
out/server
build
node_modules

# Version control & editor cruft
.git
.vscode
.idea
.claude

# Logs & temp files
*.log
*.tmp

# Dockerfiles themselves don't belong in the build context
Dockerfile*
docker-compose*

# Docs & non-runtime misc
docs
.github
