{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "server.vite.config.*",
    "vite.kuromoji-plugin.ts",
    "vite.react-plugin.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/server/**/*",
    "src/i18n/**/*",
    "src/types/**/*",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "/@/main/*": [
        "src/main/*"
      ],
      "/@/preload/*": [
        "src/preload/*"
      ],
      "/@/server/*": [
        "src/server/*"
      ],
      "/@/shared/*": [
        "src/shared/*"
      ],
    }
  }
}
